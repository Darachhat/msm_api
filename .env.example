PROJECT_NAME="Medicine Stock Management API"
API_V1_STR="/api/v1"
APP_BASE_URL="http://localhost:8000"
ENVIRONMENT="dev"

# PostgreSQL Database
DB_DIALECT="postgresql+psycopg"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="medicine_stock_db"
DB_USER="postgres"
DB_PASS="postgres"
DB_SSL="disable"

# JWT Authentication
JWT_SECRET_KEY="change-me-to-a-strong-random-secret-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=""
R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="medicine-stock-reports"
R2_REGION="auto"
R2_PUBLIC_URL=""
R2_PRESIGNED_EXPIRE_SECONDS=3600

# CORS
WHITE_LIST_CORS=["*"]
