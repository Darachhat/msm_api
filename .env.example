PROJECT_NAME="Medicine Stock Management API"
API_V1_STR="/api/v1"
APP_BASE_URL="http://localhost:8000"
ENVIRONMENT="dev"

# PostgreSQL Database
DB_DIALECT="postgresql+psycopg"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="medicine_stock_db"
DB_USER="postgres"
DB_PASS="postgres"
DB_SSL="disable"

# JWT Authentication (RS256 PEM keys; escape newlines as \n in single-line env)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="msm_api"
JWT_AUDIENCE="msm_client"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Hybrid Auth Cookies & CSRF
COOKIE_REFRESH_NAME="msm_refresh_token"
COOKIE_CSRF_NAME="msm_csrf_token"
COOKIE_SECURE=true
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""
COOKIE_REFRESH_PATH="/api/v1/auth"

# Login Rate Limiting (In-memory sliding window)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Password Reset
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_RESET_PASSWORD_URL="http://localhost:3000/reset-password"

# CORS (never use ["*"] when allow_credentials=true with HttpOnly cookies)
WHITE_LIST_CORS=["http://localhost:3000", "http://localhost:5173"]

# Optional Local-Dev Fallbacks (primary config is stored in auth.system + auth.credential_basic)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="no-reply@msm.local"
# SMTP_USE_TLS=true

# R2_ACCOUNT_ID=""
# R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="medicine-stock-reports"
# R2_REGION="auto"
# R2_PRESIGNED_EXPIRE_SECONDS=3600
