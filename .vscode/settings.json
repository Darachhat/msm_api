{
  "liveServer.settings.port": 5501,
  "python.defaultInterpreterPath": "${workspaceFolder}/env/Scripts/python.exe",

  // --- Indentation & Tabs ---
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // --- Code Formatting & Cleanup ---
  // Disable formatOnSave for python to prevent standard formatters (like Black, Ruff, or autopep8)
  // from stripping out the vertical alignments and leading-comma formatting patterns.
  "[python]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // --- Visual Guidelines ---
  "editor.rulers": [
    120
  ],
  "editor.renderWhitespace": "selection",

  // --- File Search Exclusions ---
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/env": true,
    "**/venv": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true
  },

  // --- Alignment Extension Configuration ---
  // Configuration settings for the popular WWm "Alignment" extension (wwm.align)
  // to help easily align equals, colons, and commas manually or via shortcut.
  "alignment.chars": {
    "=": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    ":": {
      "spaceBefore": 1,
      "spaceAfter": 1
    },
    ",": {
      "spaceBefore": 1,
      "spaceAfter": 1
    }
  }
}
